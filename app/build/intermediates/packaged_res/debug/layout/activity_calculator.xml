<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    >

    <TextView
        android:id="@+id/tv_calculator_expression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/tv_calculator_result"
        android:gravity="end"
        android:padding="10dp"
        android:textSize="24sp"
        android:maxLines="2"
        android:ellipsize="start"
        tools:text="16%5=" />

    <TextView
        android:id="@+id/tv_calculator_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/guideline_buttons"
        android:gravity="end"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="1" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.4"
        android:layout_above="@id/ll_buttons"/>


    <LinearLayout
        android:id="@+id/ll_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <Button
                android:id="@+id/btn_clear"
                style="@style/CalculatorButton.Special"
                android:text="C" />

            <Button
                android:id="@+id/btn_backspace"
                style="@style/CalculatorButton.Special"
                android:text="⌫"
                app:icon="@android:drawable/ic_input_delete"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:padding="0dp"
                />
            <!-- 使用 Unicode 退格符号，或者用图标 -->


            <Button
                android:id="@+id/btn_percent"
                style="@style/CalculatorButton.Special"
                android:text="%" />

            <Button
                android:id="@+id/btn_divide"
                style="@style/CalculatorButton.Operator"
                android:text="÷" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <Button
                android:id="@+id/btn_7"
                style="@style/CalculatorButton"
                android:text="7" />

            <Button
                android:id="@+id/btn_8"
                style="@style/CalculatorButton"
                android:text="8" />

            <Button
                android:id="@+id/btn_9"
                style="@style/CalculatorButton"
                android:text="9" />

            <Button
                android:id="@+id/btn_multiply"
                style="@style/CalculatorButton.Operator"
                android:text="×" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <Button
                android:id="@+id/btn_4"
                style="@style/CalculatorButton"
                android:text="4" />

            <Button
                android:id="@+id/btn_5"
                style="@style/CalculatorButton"
                android:text="5" />

            <Button
                android:id="@+id/btn_6"
                style="@style/CalculatorButton"
                android:text="6" />

            <Button
                android:id="@+id/btn_subtract"
                style="@style/CalculatorButton.Operator"
                android:text="-" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <Button
                android:id="@+id/btn_1"
                style="@style/CalculatorButton"
                android:text="1" />

            <Button
                android:id="@+id/btn_2"
                style="@style/CalculatorButton"
                android:text="2" />

            <Button
                android:id="@+id/btn_3"
                style="@style/CalculatorButton"
                android:text="3" />

            <Button
                android:id="@+id/btn_add"
                style="@style/CalculatorButton.Operator"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_0"
                style="@style/CalculatorButton"
                android:layout_weight="2.04"
                android:text="0" />
            <!-- 稍微调整权重以适应三个按钮的空间 -->

            <Button
                android:id="@+id/btn_dot"
                style="@style/CalculatorButton"
                android:text="." />

            <Button
                android:id="@+id/btn_equals"
                style="@style/CalculatorButton.Operator"
                android:text="=" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout> 