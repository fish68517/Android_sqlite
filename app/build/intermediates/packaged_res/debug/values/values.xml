<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="calculator_default_button_bg_color">#D3D3D3</color>
    <color name="calculator_digit_bg_color">#E0E0E0</color>
    <color name="calculator_digit_text_color">#000000</color>
    <color name="calculator_operator_bg_color">#FF9800</color>
    <color name="calculator_operator_text_color">#FFFFFF</color>
    <color name="calculator_special_bg_color">#B0BEC5</color>
    <color name="calculator_special_text_color">#000000</color>
    <color name="colorAccent">#365FF4</color>
    <color name="colorPrimary">#F8006C</color>
    <color name="colorPrimaryDark">#FFFFFFFF</color>
    <color name="gray">#A7A7A9</color>
    <color name="white">#FFFFFFFF</color>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        
        
    </style>
    <style name="CalculatorButton" parent="CalculatorButtonBase">
        
        <item name="android:background">@drawable/calculator_button_digit_background</item>
        <item name="android:textColor">@color/calculator_digit_text_color</item>
    </style>
    <style name="CalculatorButton.Operator" parent="CalculatorButtonBase">
        
        <item name="android:background">@drawable/calculator_button_operator_background</item>
        <item name="android:textColor">@color/calculator_operator_text_color</item>
    </style>
    <style name="CalculatorButton.Special" parent="CalculatorButtonBase">
        
        <item name="android:background">@drawable/calculator_button_special_background</item>
        <item name="android:textColor">@color/calculator_special_text_color</item>
         <item name="android:textSize">20sp</item> 
    </style>
    <style name="CalculatorButtonBase" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/calculator_button_background</item> 
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication"/>
</resources>