<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="vertical" android:padding="20dp">
    <TextView style="@style/LabTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fragment 新闻 · 平板双栏" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <FrameLayout android:id="@+id/newsListContainer" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <Space android:layout_width="12dp" android:layout_height="1dp" />
        <FrameLayout android:id="@+id/newsDetailContainer" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" />
    </LinearLayout>
</LinearLayout>

