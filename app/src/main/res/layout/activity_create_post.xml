<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <include layout="@layout/layout_toolbar" />

        <FrameLayout
            android:id="@+id/imageUploadArea"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="@dimen/screen_margin">

            <ImageView
                android:id="@+id/selectedImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Selected image" />

            <LinearLayout
                android:id="@+id/uploadPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/light_gray">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击上传图片"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/dark_gray" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/screen_margin">

            <Button
                android:id="@+id/selectFromGalleryButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="相册"
                android:textSize="@dimen/text_size_body"
                android:background="?attr/colorPrimary"
                android:layout_marginEnd="@dimen/screen_margin_small" />

            <Button
                android:id="@+id/takePhotoButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="拍照"
                android:textSize="@dimen/text_size_body"
                android:background="?attr/colorSecondary" />
        </LinearLayout>

        <EditText
            android:id="@+id/postTitleInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:hint="帖子标题"
            android:inputType="text"
            android:padding="@dimen/screen_margin_small"
            android:background="@color/md_theme_light_surface_variant"
            android:textSize="@dimen/text_size_body"
            android:layout_marginBottom="@dimen/screen_margin" />

        <EditText
            android:id="@+id/postContentInput"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="帖子内容..."
            android:inputType="textMultiLine"
            android:gravity="top"
            android:padding="@dimen/screen_margin_small"
            android:background="@color/md_theme_light_surface_variant"
            android:textSize="@dimen/text_size_body"
            android:layout_marginBottom="@dimen/screen_margin" />

        <EditText
            android:id="@+id/postTagsInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:hint="标签 (多个标签请用逗号分隔)"
            android:inputType="text"
            android:padding="@dimen/screen_margin_small"
            android:background="@color/md_theme_light_surface_variant"
            android:textSize="@dimen/text_size_body"
            android:layout_marginBottom="@dimen/screen_margin" />

        <Button
            android:id="@+id/publishButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="发布"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:background="?attr/colorPrimary"
            android:layout_marginBottom="@dimen/screen_margin" />

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="取消"
            android:textSize="@dimen/text_size_body"
            android:background="@color/md_theme_light_outline" />

    </LinearLayout>

</ScrollView>