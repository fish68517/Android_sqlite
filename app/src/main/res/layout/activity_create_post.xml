<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Post"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:textColor="@color/md_theme_light_primary"
            android:layout_marginBottom="@dimen/screen_margin" />

        <!-- Image Upload Area -->
        <FrameLayout
            android:id="@+id/imageUploadArea"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="@dimen/screen_margin">

            <ImageView
                android:id="@+id/selectedImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Selected image" />

            <LinearLayout
                android:id="@+id/uploadPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/light_gray">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to upload image"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/dark_gray" />
            </LinearLayout>
        </FrameLayout>

        <!-- Image Upload Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/screen_margin">

            <Button
                android:id="@+id/selectFromGalleryButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="Gallery"
                android:textSize="@dimen/text_size_body"
                android:background="?attr/colorPrimary"
                android:layout_marginEnd="@dimen/screen_margin_small" />

            <Button
                android:id="@+id/takePhotoButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="Camera"
                android:textSize="@dimen/text_size_body"
                android:background="?attr/colorSecondary" />
        </LinearLayout>

        <!-- Title Input -->
        <EditText
            android:id="@+id/postTitleInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:hint="Post Title"
            android:inputType="text"
            android:padding="@dimen/screen_margin_small"
            android:background="@color/md_theme_light_surface_variant"
            android:textSize="@dimen/text_size_body"
            android:layout_marginBottom="@dimen/screen_margin" />

        <!-- Content Input -->
        <EditText
            android:id="@+id/postContentInput"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="Post Content"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:padding="@dimen/screen_margin_small"
            android:background="@color/md_theme_light_surface_variant"
            android:textSize="@dimen/text_size_body"
            android:layout_marginBottom="@dimen/screen_margin" />

        <!-- Tags Input -->
        <EditText
            android:id="@+id/postTagsInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:hint="Tags (comma separated)"
            android:inputType="text"
            android:padding="@dimen/screen_margin_small"
            android:background="@color/md_theme_light_surface_variant"
            android:textSize="@dimen/text_size_body"
            android:layout_marginBottom="@dimen/screen_margin" />

        <!-- Publish Button -->
        <Button
            android:id="@+id/publishButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="Publish"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:background="?attr/colorPrimary"
            android:layout_marginBottom="@dimen/screen_margin" />

        <!-- Cancel Button -->
        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="Cancel"
            android:textSize="@dimen/text_size_body"
            android:background="@color/md_theme_light_outline" />

    </LinearLayout>

</ScrollView>
