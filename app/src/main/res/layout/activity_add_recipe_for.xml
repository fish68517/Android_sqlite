<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/component_spacing">

        <Button
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="&lt;"
            android:textSize="@dimen/text_size_subtitle"
            android:background="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Recipe to Schedule"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            android:textColor="@color/md_theme_light_primary"
            android:layout_marginStart="@dimen/screen_margin" />
    </LinearLayout>

    <!-- Date Selection Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/component_spacing">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Date"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:textColor="@color/md_theme_light_primary"
            android:layout_marginBottom="@dimen/screen_margin_small" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/selectedDateTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2024-01-01"
                android:textSize="@dimen/text_size_body"
                android:textColor="@android:color/black" />

            <Button
                android:id="@+id/selectDateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change Date"
                android:textSize="@dimen/text_size_small"
                android:background="?attr/colorPrimary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Meal Type Selection Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/component_spacing">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Meal Type"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:textColor="@color/md_theme_light_primary"
            android:layout_marginBottom="@dimen/screen_margin_small" />

        <RadioGroup
            android:id="@+id/mealTypeRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Breakfast"
                android:textSize="@dimen/text_size_body"
                android:layout_marginBottom="@dimen/screen_margin_small" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lunch"
                android:textSize="@dimen/text_size_body"
                android:layout_marginBottom="@dimen/screen_margin_small" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dinner"
                android:textSize="@dimen/text_size_body" />
        </RadioGroup>
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/component_spacing">

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="@dimen/text_size_body"
            android:background="@android:color/darker_gray"
            android:layout_marginEnd="@dimen/screen_margin_small" />

        <Button
            android:id="@+id/confirmButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="Confirm"
            android:textSize="@dimen/text_size_body"
            android:background="?attr/colorPrimary"
            android:layout_marginStart="@dimen/screen_margin_small" />
    </LinearLayout>

</LinearLayout>
