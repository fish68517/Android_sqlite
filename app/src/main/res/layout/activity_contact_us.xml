<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <include layout="@layout/layout_toolbar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="欢迎通过以下任何方式与我们取得联系"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/dark_gray"
            android:layout_marginBottom="@dimen/screen_margin" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="电子邮箱"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            android:textColor="@color/md_theme_light_primary"
            android:layout_marginTop="@dimen/screen_margin"
            android:layout_marginBottom="@dimen/screen_margin_small" />

        <TextView
            android:id="@+id/emailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="support@healthdietapp.com"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/dark_gray"
            android:layout_marginBottom="@dimen/screen_margin_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emailButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="发送邮件"
            android:textSize="@dimen/text_size_body"
            android:layout_marginBottom="@dimen/screen_margin"
            app:cornerRadius="@dimen/button_corner_radius" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="联系电话"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            android:textColor="@color/md_theme_light_primary"
            android:layout_marginTop="@dimen/screen_margin"
            android:layout_marginBottom="@dimen/screen_margin_small" />

        <TextView
            android:id="@+id/phoneText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+1-800-123-4567"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/dark_gray"
            android:layout_marginBottom="@dimen/screen_margin_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/phoneButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="拨打电话"
            android:textSize="@dimen/text_size_body"
            android:layout_marginBottom="@dimen/screen_margin"
            app:cornerRadius="@dimen/button_corner_radius" />

        <TextView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="关注我们"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            android:textColor="@color/md_theme_light_primary"
            android:layout_marginTop="@dimen/screen_margin"
            android:layout_marginBottom="@dimen/screen_margin_small" />

        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/screen_margin">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/facebookButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="Facebook"
                android:textSize="@dimen/text_size_small"
                android:layout_marginEnd="@dimen/screen_margin_small"
                app:cornerRadius="@dimen/button_corner_radius" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/twitterButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="Twitter"
                android:textSize="@dimen/text_size_small"
                android:layout_marginEnd="@dimen/screen_margin_small"
                app:cornerRadius="@dimen/button_corner_radius" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/instagramButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="Instagram"
                android:textSize="@dimen/text_size_small"
                app:cornerRadius="@dimen/button_corner_radius" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="我们随时为您提供帮助！如果您有任何问题、反馈或疑虑，请随时联系我们。我们的团队通常会在24小时内给您回复。"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/dark_gray"
            android:layout_marginTop="@dimen/screen_margin" />

    </LinearLayout>

</ScrollView>