<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin"
    android:background="@color/md_theme_light_background">

    <!-- Date Navigation Bar -->
    <LinearLayout
        android:id="@+id/dateNavigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/component_spacing">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prevDateButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="&lt;"
            android:textSize="@dimen/text_size_subtitle"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="@dimen/button_corner_radius"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/datePickerButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/component_spacing"
            android:layout_marginEnd="@dimen/component_spacing"
            android:text="选择日期"
            android:textSize="@dimen/text_size_subtitle"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/md_theme_light_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextDateButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text=">"
            android:textSize="@dimen/text_size_subtitle"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="@dimen/button_corner_radius"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    </LinearLayout>

    <!-- My Recipes Section -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/myRecipesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="我的食谱"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"

        android:layout_marginBottom="@dimen/component_spacing" />

    <!-- Breakfast Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/breakfastCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/component_spacing"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/elevation_small"
        app:strokeColor="@color/md_theme_light_outline"
        app:strokeWidth="1dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/breakfastTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="早餐"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:textColor="@color/md_theme_light_primary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/breakfastRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无安排"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/md_theme_light_on_surface_variant"
                android:layout_marginTop="@dimen/screen_margin_small" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Lunch Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lunchCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/component_spacing"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/elevation_small"
        app:strokeColor="@color/md_theme_light_outline"
        app:strokeWidth="1dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/lunchTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="午餐"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:textColor="@color/md_theme_light_primary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/lunchRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无安排"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/md_theme_light_on_surface_variant"
                android:layout_marginTop="@dimen/screen_margin_small"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Dinner Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dinnerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/component_spacing"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/elevation_small"
        app:strokeColor="@color/md_theme_light_outline"
        app:strokeWidth="1dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/dinnerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="晚餐"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:textColor="@color/md_theme_light_primary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/dinnerRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无安排"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/md_theme_light_on_surface_variant"
                android:layout_marginTop="@dimen/screen_margin_small" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Record Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/recordHealthDataButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="记录每日健康数据"
        android:layout_marginBottom="@dimen/component_spacing"
        app:cornerRadius="@dimen/button_corner_radius" />

    <!-- Recommended Recipes Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/component_spacing">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/recommendedTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="推荐食谱"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"

            android:textColor="@color/md_theme_light_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/moreRecommendedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="更多"
            app:cornerRadius="@dimen/button_corner_radius"
            app:iconPadding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recommendedRecipesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>