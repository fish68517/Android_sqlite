<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/LabTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="手机多媒体中心" />
        <TextView style="@style/LabSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="通知、拍照、相册、提示音和网络视频" />
        <ImageView android:id="@+id/ivMediaImage" android:layout_width="match_parent" android:layout_height="220dp" android:background="@drawable/bg_card" android:contentDescription="拍照或相册图片" android:scaleType="centerCrop" android:src="@drawable/ic_launcher" />
        <Button android:id="@+id/btnTakePhoto" style="@style/LabButton" android:text="调用系统相机拍照" />
        <Button android:id="@+id/btnPickImage" style="@style/LabButton" android:text="从相册选择图片" />
        <Button android:id="@+id/btnNotify" style="@style/LabButton" android:text="发送图片风格通知" />
        <Button android:id="@+id/btnPlayTone" style="@style/LabButton" android:text="播放提示音" />
        <Button android:id="@+id/btnPlayVideo" style="@style/LabButton" android:text="播放网络示例视频" />
        <VideoView android:id="@+id/videoView" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="10dp" />
    </LinearLayout>
</ScrollView>

