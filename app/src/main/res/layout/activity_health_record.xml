<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin"
    android:background="@color/md_theme_light_background">

    <!-- Header with Back Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/component_spacing">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="&lt;"
            android:textSize="@dimen/text_size_subtitle"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="@dimen/button_corner_radius"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Health Record"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            android:textColor="@color/md_theme_light_primary"
            android:layout_marginStart="@dimen/screen_margin" />
    </LinearLayout>

    <!-- Date Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/component_spacing">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prevDateButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="&lt;"
            android:textSize="@dimen/text_size_subtitle"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="@dimen/button_corner_radius"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/datePickerButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/screen_margin_small"
            android:layout_marginEnd="@dimen/screen_margin_small"
            android:text="Today"
            android:textSize="@dimen/text_size_body"
            app:cornerRadius="@dimen/button_corner_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextDateButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text=">"
            android:textSize="@dimen/text_size_subtitle"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="@dimen/button_corner_radius"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
    </LinearLayout>

    <!-- ScrollView for content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- No Record Message -->
            <TextView
                android:id="@+id/noRecordMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You haven't recorded any data for this date"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/md_theme_light_on_surface_variant"
                android:gravity="center"
                android:padding="@dimen/screen_margin"
                android:visibility="gone" />

            <!-- Weight Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/weightSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/component_spacing"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/elevation_small"
                app:strokeColor="@color/md_theme_light_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_margin">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Weight (kg)"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
                        app:boxCornerRadiusTopStart="@dimen/button_corner_radius">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/weightInput"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Water Intake Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/waterSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/component_spacing"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/elevation_small"
                app:strokeColor="@color/md_theme_light_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_margin">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Water Intake (ml)"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
                        app:boxCornerRadiusTopStart="@dimen/button_corner_radius">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/waterInput"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Measurements Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/measurementsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/component_spacing"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/elevation_small"
                app:strokeColor="@color/md_theme_light_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_margin">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Body Measurements (cm)"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
                        app:boxCornerRadiusTopStart="@dimen/button_corner_radius">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/measurementsInput"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height"
                            android:inputType="text"
                            android:hint="e.g., Chest: 90, Waist: 75, Hip: 95" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="Save Record"
        android:textSize="@dimen/text_size_body"
        android:layout_marginTop="@dimen/component_spacing"
        app:cornerRadius="@dimen/button_corner_radius" />

</LinearLayout>
