<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="vertical" android:padding="20dp">
    <TextView style="@style/LabTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="后台下载演示" />
    <TextView style="@style/LabSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Service、Thread、Handler、前台通知和生命周期" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical">
        <TextView android:id="@+id/tvDownloadStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="尚未开始" android:textColor="@color/text_primary" android:textSize="18sp" />
        <ProgressBar android:id="@+id/progressDownload" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:max="100" />
        <Button android:id="@+id/btnStartDownload" style="@style/LabButton" android:text="启动后台下载模拟" />
        <Button android:id="@+id/btnStopDownload" style="@style/LabButton" android:text="停止服务" />
    </LinearLayout>
</LinearLayout>

