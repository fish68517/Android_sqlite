<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/tvNoteDetailTitle" style="@style/LabTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvNoteDetailContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_card" android:textColor="@color/text_primary" android:textSize="17sp" />
    <Button android:id="@+id/btnReturnResult" style="@style/LabButton" android:text="返回并通知上一页" />
</LinearLayout>

