<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/detail_attraction_image"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"/>

            <TextView
                android:id="@+id/detail_attraction_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="景点名称"
                android:textSize="24sp"
                android:textStyle="bold"
                android:padding="16dp"/>

            <TextView
                android:id="@+id/detail_attraction_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="景点描述..."
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"/>

            <TextView
                android:id="@+id/detail_attraction_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="地点: "
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/detail_attraction_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="价格: "
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"/>

            <Button
                android:id="@+id/button_book_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="立即预订"/>

        </LinearLayout>
    </ScrollView>
</RelativeLayout> 