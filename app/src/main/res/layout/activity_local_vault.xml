<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="vertical" android:padding="20dp">
    <TextView style="@style/LabTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="本地账号与备忘录" />
    <TextView style="@style/LabSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SharedPreferences + SQLite 增删改查" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical">
        <EditText android:id="@+id/etVaultUser" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="用户名" android:inputType="text" />
        <EditText android:id="@+id/etVaultPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="演示密码" android:inputType="textPassword" />
        <CheckBox android:id="@+id/cbRememberPassword" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="记住密码（课程演示）" />
        <EditText android:id="@+id/etMemo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="输入备忘录" android:inputType="textCapSentences" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnAddMemo" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="新增" android:textAllCaps="false" />
            <Button android:id="@+id/btnUpdateMemo" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="更新选中项" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="点击列表项进行编辑，长按删除" android:textColor="@color/text_secondary" />
    <ListView android:id="@+id/listMemos" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:dividerHeight="1dp" />
</LinearLayout>

