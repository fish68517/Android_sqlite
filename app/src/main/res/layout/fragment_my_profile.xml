<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MyProfileFragment">

    <ImageView
        android:id="@+id/merchantImageView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/merchantNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="商家名称"
        android:textSize="18sp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/merchantWindowLocationTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="窗口位置"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/merchantBusinessHoursTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="营业时间"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/merchantContentTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="餐馆描述"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/merchantBrowseCountTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="浏览次数"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/buttonEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="设置"
        android:layout_marginTop="16dp" />

</LinearLayout>
