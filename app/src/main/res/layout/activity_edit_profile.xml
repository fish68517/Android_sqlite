<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin"
    android:background="@color/md_theme_light_background">

    <include layout="@layout/layout_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="@dimen/screen_margin"
                android:layout_marginBottom="@dimen/screen_margin_large">

                <ImageView
                    android:id="@+id/avatarImageView"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_default_avatar"
                    android:contentDescription="用户头像" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/changeAvatarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="更换头像"
                    android:layout_marginTop="@dimen/screen_margin_small"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/screen_margin"
                android:hint="昵称"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/button_corner_radius">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nicknameInput"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/screen_margin_large"
                android:hint="账号 (不可修改)"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/button_corner_radius">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/usernameTextView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="none"
                    android:enabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="保存修改"
        android:textSize="@dimen/text_size_body"
        android:layout_marginTop="@dimen/screen_margin"
        app:cornerRadius="@dimen/button_corner_radius" />

</LinearLayout>