<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin"
    android:background="@color/md_theme_light_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/screen_margin">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back"
            app:cornerRadius="@dimen/button_corner_radius"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/edit_profile_title"
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/md_theme_light_on_surface"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Avatar Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="@dimen/screen_margin_large">

                <!-- Avatar Image -->
                <ImageView
                    android:id="@+id/avatarImageView"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_default_avatar"
                    android:contentDescription="@string/user_avatar"
                    android:scaleType="centerCrop"
                    android:layout_marginBottom="@dimen/screen_margin_small" />

                <!-- Upload Avatar Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uploadAvatarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_avatar"
                    app:cornerRadius="@dimen/button_corner_radius" />

            </LinearLayout>

            <!-- Nickname Section -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/screen_margin"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/button_corner_radius">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nicknameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:hint="@string/nickname_hint"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Username Display (Read-only) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/screen_margin_large"
                android:hint="@string/username_label"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/button_corner_radius">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/usernameTextView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="none"
                    android:enabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/save_button"
        android:textSize="@dimen/text_size_button"
        android:layout_marginTop="@dimen/screen_margin"
        app:cornerRadius="@dimen/button_corner_radius" />

</LinearLayout>
