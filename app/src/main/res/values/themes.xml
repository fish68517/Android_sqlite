<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.BookTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Navigation bar color. -->
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Customize other theme attributes. -->
        <item name="android:windowBackground">@color/background</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.LargeComponent</item>
        <!-- Text appearance -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.BookTracker.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.BookTracker.HeadlineMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.BookTracker.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.BookTracker.BodyMedium</item>
        <!-- Card and elevation styles -->
        <item name="cardElevation">1dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">8dp</item>
        <!-- Dialog styles -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="Theme.BookTracker" parent="Base.Theme.BookTracker" />
    
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.BookTracker.MaterialAlertDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.BookTracker.MaterialAlertDialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.BookTracker.MaterialAlertDialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.BookTracker.MaterialAlertDialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.BookTracker.MaterialAlertDialog.Button</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorPrimary">@color/secondary_dark</item>
    </style>
    
    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>