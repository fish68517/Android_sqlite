<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OrderFood"
        tools:targetApi="31">

        <!-- LoginActivity is now the starting point -->
        <activity
            android:name="com.example.application.activity.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.application.activity.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".activity.LeaveApplicationActivity"
            android:exported="false" />
        <activity
            android:name=".activity.LeaveApprovalActivity"
            android:exported="false" />

        <activity
            android:name=".UserManageActivity"
            android:exported="false" />

        <activity
            android:name="com.example.application.activity.AdminMainActivity"
            android:exported="false" />

        <activity
            android:name=".activity.AppointmentActivity"
            android:exported="false" />

        <activity
            android:name=".activity.StudentCheckinStatusActivity"
            android:exported="false" />

        <activity
            android:name=".activity.DoctorHomeActivity"
            android:exported="false" />


        <activity
            android:name=".activity.ManageNotificationsActivity"
            android:exported="false" />

        <activity
            android:name="com.example.application.activity.DoctorMainActivity"
            android:exported="false" />

        <activity
            android:name="com.example.application.activity.TeacherMainActivity"
            android:exported="false" />


        <!-- MainActivity no longer has the LAUNCHER intent-filter -->
        <activity
            android:name="com.example.application.MainActivity"
            android:exported="true">
            <!-- The intent-filter was here, but now it's gone -->
        </activity>

    </application>

</manifest>